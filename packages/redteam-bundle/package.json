{
  "name": "dsh-redteam-mode",
  "version": "0.11.0",
  "description": "DSH RedTeam 模式：一句话拉起红队作战智能体（资产测绘 / 攻击链 / 得分目标 / 报告 / POC 知识库），含六个角色、23 个原生技能、常驻右侧控制台与一键自动更新",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./store": "./lib/store.js",
    "./ui": "./lib/ui.js",
    "./tools": "./lib/tools.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "presets",
    "skills",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "redteam",
    "红队",
    "攻防演练",
    "pentest",
    "security",
    "asset-management",
    "knowledge-base"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "prepublishOnly": "node tools/build.mjs --check && node tools/test-all.mjs",
    "test": "node tools/test-all.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jueze-2019/dsh-redteam-mode.git",
    "directory": "packages/redteam-bundle"
  },
  "homepage": "https://github.com/Jueze-2019/dsh-redteam-mode",
  "bugs": {
    "url": "https://github.com/Jueze-2019/dsh-redteam-mode/issues"
  },
  "author": "Jueze",
  "engines": {
    "dsh": ">=0.1.0-rc.6"
  }
}
